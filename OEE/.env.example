# Copie para .env e preencha com os dados do registro de aplicativo no Entra ID
# (portal.azure.com > Microsoft Entra ID > Registros de aplicativo).

# ID do diretório (locatário)
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ID do aplicativo (cliente)
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Valor do segredo do cliente (Certificados e segredos)
ENTRA_CLIENT_SECRET=troque-me
# Deve estar cadastrado como URI de redirecionamento "Web" no registro do app
ENTRA_REDIRECT_URI=http://localhost:5000/auth/callback

# Chave para assinar a sessão do Flask (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=troque-me

# Opcional: restringe o acesso a membros destes grupos do Entra ID (IDs separados por vírgula)
# ENTRA_ALLOWED_GROUPS=
